# Copie este arquivo para ".env" e preencha a sua chave.
# Gere a chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-troque-por-sua-chave

# Opcionais: aparecem nos rankings publicos do OpenRouter.
OPENROUTER_APP_NAME=Ponto Certo
OPENROUTER_SITE_URL=http://localhost:8000

# --- Supabase (opcional: sem isto o sistema roda, so nao grava lotes no banco) ---
# Painel do Supabase > Connect > Session pooler (porta 5432)
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# Painel > Project Settings > API: URL do projeto e chave secreta (sb_secret_...)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_troque-pela-sua-chave
# Nome exato do bucket privado das fotos (maiusculas contam)
SUPABASE_BUCKET=Capturas
