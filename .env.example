# Copie este arquivo para ".env". Tudo aqui é opcional: o que ficar vazio fica desligado.

# Explicações por IA. Gere a chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcionais: aparecem nos rankings publicos do OpenRouter.
OPENROUTER_APP_NAME=Ponto Certo
OPENROUTER_SITE_URL=http://localhost:8000

# --- Supabase (sem isto o sistema roda e guarda tudo neste computador) ---
# Painel do Supabase > Connect > Session pooler (porta 5432)
# ex.: postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Painel > Project Settings > API: URL do projeto (https://SEU-PROJETO.supabase.co) e chave secreta (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Nome exato do bucket privado das fotos (maiusculas contam)
SUPABASE_BUCKET=Capturas

# Gestão: local (JSON) ou supabase (execute supabase/gestao.sql antes de ativar).
GESTAO_STORAGE=local

# Avisos de recebimento pelo Microsoft 365 / Microsoft Graph.
# Exige aplicativo Entra ID com Mail.Send (Application) e consentimento do administrador.
# Não há envio automático: cada mensagem exige revisão e confirmação na tela.
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_SENDER=
